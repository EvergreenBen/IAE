{
  "name": "arxitect",
  "productName": "Arxitect",
  "version": "0.1.0",
  "description": "Arxitect — a desktop place to architect software with Claude, built on Claude Code.",
  "main": "./out/main/index.js",
  "author": "Ben Williams",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "web": "vite --config vite.web.config.ts",
    "voice:setup": "node scripts/fetch-voice-models.mjs",
    "test": "vitest run",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --mac dmg zip --arm64",
    "dist:win": "node scripts/fetch-win-agents.mjs && npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.291",
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/codex-sdk": "^0.166.0",
    "chokidar": "^5.0.0",
    "ignore": "^7.0.12",
    "nanoid": "^5.1.16",
    "picomatch": "^4.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-timer": "^3.0.2",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2",
    "d3-ease": "^3.0.1",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-timer": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.12.0",
    "fast-glob": "^3.3.3",
    "kokoro-js": "^1.2.1",
    "motion": "^14.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  },
  "type": "module",
  "overrides": {
    "kokoro-js": {
      "@huggingface/transformers": "$@huggingface/transformers"
    }
  }
}
