# Recipe Box API: local environment
# FAKE demo values, not real credentials.

# ── Database ──
# Postgres from infra/docker-compose.yml. Drizzle and the session store both read it.
DATABASE_URL=postgres://recipebox:recipebox@localhost:5432/recipebox

# ── Google sign-in ──
# OAuth client from the Google Cloud console.
GOOGLE_CLIENT_ID=000000000000-fakefakefakefake.apps.googleusercontent.com
# Keep this one secret. It signs the OAuth exchange.
GOOGLE_CLIENT_SECRET=GOCSPX-FAKE-DO-NOT-USE-0000000000

# ── Sessions ──
# How long a sign-in lasts before people sign in again.
SESSION_TTL_DAYS=30

# ── Photos ──
# Bucket for recipe photos and thumbnails (MinIO locally).
S3_BUCKET=recipe-box-dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── Email ──
# Resend key for the weekly digest.
RESEND_API_KEY=re_FAKE_demo_key_not_real_0000
